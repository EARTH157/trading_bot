# Mode: 'paper', 'alpaca_paper', 'alpaca_live', 'settrade'
APP_MODE=paper

# Web Dashboard Server
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
SECRET_KEY=trading_bot_secret_key_12345

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Watchlist (comma-separated stock tickers)
WATCHLIST=AAPL,NVDA,MSFT,TSLA,AMZN

# Paper Trading Initial Settings
INITIAL_BALANCE=100000.0
CURRENCY=USD

# Risk Management Settings
MAX_RISK_PER_TRADE_PCT=2.0
STOP_LOSS_PCT=3.0
TAKE_PROFIT_PCT=6.0
MAX_DAILY_LOSS_PCT=5.0

# Alpaca API (สำหรับหุ้นสหรัฐฯ - Optional)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_IS_PAPER=true

# SETTRADE Open API (สำหรับหุ้นไทย - Optional)
SETTRADE_APP_ID=
SETTRADE_APP_SECRET=
SETTRADE_BROKER_ID=000
SETTRADE_ACCOUNT_NO=

# Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_NOTIFY_TOKEN=
